rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ firebase-config.js 의 SITE_OWNER_EMAILS 와 반드시 동일하게 맞춰주세요.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "ekcjs20100329@gmail.com"
      ];
    }

    function hasCreateSeriesPermission() {
      return isAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/permissions/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data.canCreateSeries == true);
    }

    function hasManageTiersPermission() {
      return isAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/permissions/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data.canManageTiers == true);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /permissions/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email in request.resource.data.ownerEmails
                    && hasCreateSeriesPermission();
      allow update: if request.auth != null
                    && (request.auth.token.email in resource.data.ownerEmails || isAdmin());
      allow delete: if false;

      match /videos/{videoId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.token.email in get(/databases/$(database)/documents/series/$(seriesId)).data.ownerEmails;
        allow update: if (request.auth != null
                      && request.auth.token.email in get(/databases/$(database)/documents/series/$(seriesId)).data.ownerEmails)
                      || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
        allow delete: if request.auth != null
                      && request.auth.token.email in get(/databases/$(database)/documents/series/$(seriesId)).data.ownerEmails;

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null && (
            commentId == request.auth.uid ||
            (isAdmin() && request.resource.data.isDummy == true)
          );
          allow update: if request.auth != null && (
            commentId == request.auth.uid ||
            (isAdmin() && resource.data.isDummy == true) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          );
          allow delete: if request.auth != null && (
            commentId == request.auth.uid || isAdmin()
          );
        }
      }
    }

    match /tiers/{tierId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.creatorEmail == request.auth.token.email;
      allow update: if (request.auth != null && (
                      resource.data.creatorEmail == request.auth.token.email ||
                      isAdmin() || hasManageTiersPermission()
                    ))
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays']);
      allow delete: if request.auth != null && (
                    resource.data.creatorEmail == request.auth.token.email ||
                    isAdmin() || hasManageTiersPermission()
                  );
    }
  }
}
